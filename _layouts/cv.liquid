---
layout: default
---

{% if page.cv_pdf %}
  {% if page.cv_pdf contains '://' %}
    {% assign resume_url = page.cv_pdf %}
  {% else %}
    {% assign resume_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
  {% endif %}
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}

      {% comment %}
      {% if page.cv_pdf %}
        <a
          href="{{ resume_url }}"
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
          title="Open PDF"
          aria-label="Open resume PDF"
        >
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
      {% endcomment %}
    </h1>

    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      {% if page.cv_pdf %}
        <iframe
          src="{{ resume_url }}"
          width="100%"
          height="1100"
          style="border: none;"
          title="Resume PDF"
        ></iframe>
      {% endif %}
    </div>
  </article>
</div>